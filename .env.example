# Settings read by docker compose. Copy to .env to override; every value
# shown is the default. Credentials are for the local RustFS only.
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
S3_BUCKET=villagestat
RUSTFS_TAG=1.0.4

# Release served by the API replicas (must exist in the bucket).
RELEASE_ID=diy-2026-11-b

# Per-replica limits and caches (docs/api.md, docs/caching.md).
DUCKDB_MEMORY_LIMIT=2GB
DUCKDB_THREADS=4
MAX_VILLAGES=10000
QUERY_TIMEOUT=30s
RESULT_CACHE_ENTRIES=2000000
BLOCK_CACHE_MB=256
REF_CACHE_PROVINCES=4

# Prep container memory (docs/prep.md).
PREP_MEMORY_LIMIT=6GB
