# Serving image: Go API + embedded DuckDB. No GDAL. Extensions baked in at
# build time; the API never downloads them at runtime.
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=1 go build -trimpath -o /out/api ./cmd/api && \
    CGO_ENABLED=1 go build -trimpath -o /out/seed ./cmd/seed

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && apt-get clean
COPY --from=build /out/api /out/seed /usr/local/bin/
ENV DUCKDB_EXT_DIR=/opt/duckdb_ext \
    LISTEN_ADDR=:8080 \
    WEB_DIR=/srv/web
RUN api -install-extensions
COPY web /srv/web
EXPOSE 8080
HEALTHCHECK --interval=5s --timeout=4s --start-period=5s --retries=3 CMD ["api", "-healthcheck"]
USER 65534:65534
ENTRYPOINT ["api"]
