# Prep image: Go prep CLI + GDAL (GDAL is allowed in prep only).
FROM golang:1.26-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY cmd ./cmd
COPY internal ./internal
RUN CGO_ENABLED=1 go build -trimpath -o /out/prep ./cmd/prep

FROM ghcr.io/osgeo/gdal:ubuntu-small-3.10.3
COPY --from=build /out/prep /usr/local/bin/prep
ENV DUCKDB_EXT_DIR=/opt/duckdb_ext
RUN prep install-extensions
WORKDIR /work
ENTRYPOINT ["prep"]
