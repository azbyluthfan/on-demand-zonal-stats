{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layers.schema.json",
  "title": "GET /v1/layers response",
  "type": "object",
  "required": ["release_id", "created_at", "boundary_version", "h3_resolution", "poi_release", "metric_types", "buildings",
               "raster_methods", "categories", "rasters", "sources"],
  "additionalProperties": false,
  "properties": {
    "release_id": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "boundary_version": { "type": "string" },
    "h3_resolution": { "type": "integer", "minimum": 0, "maximum": 15 },
    "poi_release": { "type": "string" },
    "metric_types": { "type": "array", "items": { "enum": ["poi_count", "raster_sum", "raster_mean", "raster_class_fraction", "building_count", "building_area"] } },
    "buildings": {
      "description": "The building layer, or null when the release has none.",
      "oneOf": [ { "type": "null" },
                 { "type": "object", "required": ["release"], "additionalProperties": false, "properties": { "release": { "type": "string", "minLength": 1 } } } ]
    },
    "raster_methods": { "type": "array", "items": { "enum": ["fractional", "center"] } },
    "categories": {
      "type": "array",
      "items": { "type": "object", "required": ["category", "count"], "additionalProperties": false,
                 "properties": { "category": { "type": "string", "minLength": 1 }, "count": { "type": "integer", "minimum": 1 } } }
    },
    "rasters": {
      "type": "array",
      "items": { "type": "object", "required": ["id", "kind", "units", "pixel_width", "pixel_height", "source"],
                 "properties": { "id": { "type": "string" }, "kind": { "enum": ["continuous", "categorical"] },
                                 "units": { "type": "string" }, "year": { "type": "integer" },
                                 "classes": { "type": "array", "minItems": 1,
                                              "items": { "type": "object", "required": ["value", "label"], "additionalProperties": false,
                                                         "properties": { "value": { "type": "integer" }, "label": { "type": "string", "minLength": 1 },
                                                                         "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" } } } },
                                 "pixel_width": { "type": "number", "exclusiveMinimum": 0 },
                                 "pixel_height": { "type": "number", "exclusiveMinimum": 0 }, "source": { "type": "object" } } }
    },
    "sources": {
      "type": "array",
      "items": { "type": "object", "required": ["kind", "name", "license"],
                 "properties": { "kind": { "type": "string" }, "name": { "type": "string" }, "license": { "type": "string", "minLength": 1 } } }
    }
  }
}
